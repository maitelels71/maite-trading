# Application
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database (local Postgres or RDS)
DATABASE_URL=postgresql+psycopg2://maite:maite@localhost:5432/maite

# Providers — stocks/ETFs = Schwab, futures = TradeAdvocate
USE_MOCK_PROVIDERS=true
SCHWAB_API_BASE_URL=https://api.schwabapi.com
SCHWAB_CLIENT_ID=
SCHWAB_CLIENT_SECRET=
SCHWAB_REFRESH_TOKEN=
TRADEADVOCATE_API_BASE_URL=https://api.tradeadvocate.com
TRADEADVOCATE_API_KEY=

# Strategy defaults
DEFAULT_TIMEZONE=America/New_York
DEFAULT_OPENING_RANGE_MINUTES=5

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
