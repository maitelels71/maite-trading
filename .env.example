# Copy to .env and fill in real values. Never commit .env.

# Application
APP_NAME=Maite Trading Strategy Analyzer
ENVIRONMENT=local
DEBUG=true
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database — local Postgres OR AWS RDS (preferred for shared/staging)
# On AWS, App Runner receives DATABASE_HOST / DATABASE_SECRET_ARN from CloudFormation.
DATABASE_URL=postgresql+psycopg://maite:maite@localhost:5432/maite_trading
# Windows without Postgres: sqlite+pysqlite:///C:/Code/maite-trading/.secrets/maite_trading.sqlite

# Optional when using discrete RDS env vars (App Runner style)
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_NAME=maite_trading
DATABASE_USER=maite
DATABASE_PASSWORD=
DATABASE_SECRET_ARN=
APP_SECRETS_ARN=

# Session defaults
DEFAULT_TIMEZONE=America/New_York

# --- Charles Schwab OAuth2 (stocks / ETFs market data) ---
SCHWAB_CLIENT_ID=
SCHWAB_CLIENT_SECRET=
# Local script callback (python -m scripts.schwab_login):
# SCHWAB_REDIRECT_URI=https://127.0.0.1:8182
# Staging Admin "Login with Schwab" (set this in Secrets Manager + Schwab portal):
SCHWAB_REDIRECT_URI=https://yix45u6ia8.execute-api.us-east-1.amazonaws.com/staging/admin/schwab/callback
SCHWAB_TOKEN_PATH=.secrets/schwab_token.json
# Optional: JSON token blob for Lambda (prefer Secrets Manager SCHWAB_TOKEN_JSON)
# SCHWAB_TOKEN_JSON=

# --- Futures desk ---
# Analysis candles come from Yahoo Finance (NQ=F / MNQ=F / ES=F / MES=F). No key.
# TRADEADVOCATE_* kept for a later execution adapter; unused for scans.
TRADEADVOCATE_API_KEY=
TRADEADVOCATE_API_SECRET=
TRADEADVOCATE_BASE_URL=
TRADEADVOCATE_ACCOUNT_ID=

# --- News / economic calendar (Finnhub free: https://finnhub.io) ---
FINNHUB_API_KEY=

# --- Notion Daily Review + Trade Journal sync ---
NOTION_API_KEY=
NOTION_DATABASE_ID=
NOTION_JOURNAL_DATABASE_ID=

# --- Signal alerts (Gmail preferred; SMS optional) ---
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
GMAIL_USER=
GMAIL_APP_PASSWORD=
SMS_ALERT_PHONE=
SMS_ALERTS_ENABLED=true
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Coinbase Advanced Trade (crypto rebalance bot) ---
# CDP API key from https://portal.cdp.coinbase.com/ (View + Trade). Never commit keys.
COINBASE_API_KEY=
COINBASE_API_SECRET=
# Optional path to the JSON file Coinbase downloads (preferred over pasting the PEM):
# COINBASE_KEY_FILE=.secrets/cdp_api_key.json
COINBASE_QUOTE=USD
COINBASE_ASSETS=BTC,ETH
COINBASE_CASH_PCT=0.10
COINBASE_LOOKBACK_DAYS=30
COINBASE_MAX_TRADE_USD=25
COINBASE_MIN_TRADE_USD=5
COINBASE_REBALANCE_THRESHOLD_PCT=5
COINBASE_DRY_RUN=true
COINBASE_TRADING_ENABLED=false
# Dashboard knobs persist here (max clip, cash %, lookback):
# COINBASE_SETTINGS_PATH=.secrets/coinbase_bot_settings.json

# Hub login (landing page at http://localhost:3000)
DESK_LOGIN_USER=maite
DESK_LOGIN_PASSWORD=boss

# Frontend (Next.js)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
